{
  "name": "moros",
  "version": "0.1.0",
  "description": "Moros - a general-purpose coding agent built on Pi",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "npm run build && electron-vite preview",
    "postinstall": "node scripts/prepare-pi-source.mjs",
    "prepare:pi-source": "node scripts/prepare-pi-source.mjs",
    "test:unit": "node --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "test:workbench": "node scripts/workbench-smoke.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "audit:providers": "node scripts/audit-providers.mjs",
    "audit:providers:static": "node scripts/audit-providers.mjs --static",
    "audit:providers:strict-live": "node scripts/audit-providers.mjs --strict-live"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.4",
    "@earendil-works/pi-agent-core": "file:vendor/pi/packages/agent",
    "@earendil-works/pi-ai": "file:vendor/pi/packages/ai",
    "@earendil-works/pi-client": "file:vendor/pi/packages/client",
    "@earendil-works/pi-coding-agent": "file:vendor/pi/packages/coding-agent",
    "@earendil-works/pi-protocol": "file:vendor/pi/packages/protocol",
    "@earendil-works/pi-telemetry": "file:vendor/pi/packages/telemetry",
    "@earendil-works/pi-tui": "file:vendor/pi/packages/tui",
    "@lezer/highlight": "^1.2.3",
    "@lobehub/icons": "^5.10.1",
    "@sinclair/typebox": "^0.34.52",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "lucide-react": "^1.23.0",
    "mammoth": "^1.12.2",
    "motion": "^12.42.2",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-harden": "^1.1.8",
    "streamdown": "2.5.0",
    "thinking-orbs": "0.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.0.0",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.61.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  }
}
